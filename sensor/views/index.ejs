<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Plant-Themed Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/script.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body style="background-color: #e0f2e9;">
    <header>
        <h1 style="text-align: center; color: #2e7d32;">Green Plant-Themed Dashboard</h1>
    </header>
    <main>
        <div class="container">
            <div id="controls">
                <label for="start-date">Start Date:</label>
                <input type="date" id="start-date">
                
                <label for="day-range">Days to Display:</label>
                <input type="number" id="day-range" min="1" value="7">

                <button onclick="fetchData()">Apply</button>
            </div>
            <div id="chart-container">
                <canvas id="chart" width="800" height="400"></canvas>
            </div>
        </div>
    </main>
    <footer style="text-align: center; color: #388e3c; padding: 10px;">
        Powered by Node.js and CSV
    </footer>
</body>
</html>
